<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Withdrawal_After_Exam</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Exam__r.Date__c)),
    ISPICKVAL(Registration_Status__c, &quot;Unregistered&quot;),
    Exam__r.Date__c &lt; TODAY()
)</errorConditionFormula>
    <errorMessage>A student cannot be withdrawn after the exam date.</errorMessage>
</ValidationRule>
