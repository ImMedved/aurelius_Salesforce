<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Grade_between_1_and_10</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Grade__c)),
    OR(
        Grade__c &lt; 1,
        Grade__c &gt; 10
    )
)</errorConditionFormula>
    <errorMessage>Grade must be between 1 and 10.</errorMessage>
</ValidationRule>
